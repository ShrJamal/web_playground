{
  "name": "web_playground",
  "version": "0.0.1",
  "description": "Playground template to play with Vanilla Web",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc && vp build",
    "serve": "tsc && vp build && vp preview",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "clean": "git clean -xdf **/node_modules dist .cache tsconfig.tsbuildinfo",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "latest"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "bun@1.3.14"
}
